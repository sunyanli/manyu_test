# 服务端密钥：仅服务端读取，严禁加 NEXT_PUBLIC_ 前缀（会进前端 bundle）
ALIPAY_APP_ID=2021000000000000
ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=...
ALIPAY_REDIRECT_URI=https://todo.example.com/login

# 前端可见配置（白名单：仅公网站点 origin）
NEXT_PUBLIC_SITE_URL=https://todo.example.com
