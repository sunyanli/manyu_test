<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antdigital.todo.dao.mapper.TodoItemMapper">

    <resultMap id="TodoItemResultMap" type="com.antdigital.todo.model.entity.TodoItemDO">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="user_id" property="userId"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, title, description, user_id, gmt_create, gmt_modified
    </sql>

    <insert id="insert" parameterType="com.antdigital.todo.model.entity.TodoItemDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_item (title, description, user_id, gmt_create, gmt_modified)
        VALUES (#{title}, #{description}, #{userId}, #{gmtCreate}, #{gmtModified})
    </insert>

</mapper>
